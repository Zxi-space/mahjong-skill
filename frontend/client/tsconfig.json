{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "skipLibCheck": true,
    "resolveJsonModule": true, "noEmit": true,
    "types": ["@tarojs/taro", "node"]
  },
  "include": ["src", "config", "types"]
}
